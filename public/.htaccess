RewriteEngine On
Options -Indexes

# Chống truy cập trực tiếp vào các file nhạy cảm
    RewriteRule ^(\.env|composer\.json|composer\.lock)$ - [F,L]

# Chặn file cấu hình/sao lưu/log lỡ nằm trong public
    RewriteRule (^|/)(composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]
    RewriteRule \.(bak|old|orig|sql|log|ini|sh|md)$ - [F,L]
    RewriteRule ^(vendor|node_modules)(/|$) - [F,L]



# Chặn file ẩn (.env, .git, .htpasswd...) ở mọi thư mục con (Claude)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Điều hướng các yêu cầu API
# Nếu URL có dạng /api/abc -> chuyển về api_gateway.php?route=abc

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api_gateway.php?route=$1 [L,QSA]